# GapMap Backend Environment Configuration

# Server Port (default: 3000)
PORT=3000
NODE_ENV=development

# Database path (SQLite file)
DATABASE_PATH=database/gapmap.db

# TinyFish API Key for live educational resource search (https://docs.tinyfish.ai)
# Leave empty and no online resources are shown (no made-up links)
TINYFISH_API_KEY=

# AI Vision / OCR Provider Key (Gemini Vision for answer-sheet recognition)
# Leave empty and you type the answers instead (there is no fake extraction)
GEMINI_API_KEY=
# Optional. Model name(s), comma separated. Leave empty to use the built-in defaults.
GEMINI_MODEL=

# OPTIONAL backup AI: OpenRouter (https://openrouter.ai/keys). Paste your key on the next line.
# Used automatically when Gemini is over its limit, busy or unreachable. Works alone too (no Gemini key needed).
# Photos of sheets are sent to OpenRouter and the model you choose, so tell students/parents if you use it.
OPENROUTER_API_KEY=
# Model(s), comma separated. Must be a model that can read images. Leave empty for google/gemini-2.5-flash. Not tested live here.
OPENROUTER_MODEL=

# File Upload Settings
MAX_UPLOAD_SIZE_MB=10
